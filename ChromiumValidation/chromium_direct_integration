# ---- plotting
def quick_plot(t: np.ndarray, C: np.ndarray, system: System,
               species_to_plot: Optional[List[str]] = None,
               absorbance_csv: Optional[str] = None,
               t_start_s: float = 7e-9):
    if not _HAVE_MPL:
        print("matplotlib not available; skipping plot.")
        return

    # ── Trim to t >= t_start_s ──────────────────────────────────────────────
    mask = t >= t_start_s
    t = t[mask]
    C = C[mask]
    # ────────────────────────────────────────────────────────────────────────

    sp_idx = system.species_index
    names = [s.name for s in system.species]
    targets = species_to_plot or [s for s in names if system.species[sp_idx[s]].phase == "liq"]

    fig, ax1 = plt.subplots()
    for s in targets:
        i = sp_idx[s]
        y = C[:, i]
        label = f"{s} ({'mol/L' if system.species[i].phase=='liq' else 'mol'})"
        ax1.semilogy(t, y, label=label)
    ax1.set_xlabel("Time [s]")
    ax1.set_ylabel("Concentration [mol/L]")
    ax1.legend(loc="upper left")

    if absorbance_csv is not None:
        try:
            absorbance_data = pd.read_csv(absorbance_csv)
            absorbance_data['time'] = absorbance_data['time'] * 1e-9 + 7e-9
            absorbance_time = absorbance_data['time'].to_numpy()
            absorbance_values = absorbance_data['absorbance'].to_numpy()
            ax2 = ax1.twinx()
            ax2.semilogy(absorbance_time, absorbance_values, color='red', label="Absorbance Data")
            ax2.set_ylabel("Absorbance")
            ax2.legend(loc="upper right")
        except Exception as e:
            print(f"Error loading absorbance data from CSV: {e}")

    plt.tight_layout()
    plt.savefig('your_plot_with_absorbance.png')
    plt.show()

# ---- CLI
def _load_config(path: str) -> Dict:
    with open(path, "r") as f:
        return json.load(f)

def main(argv=None):
    argv = argv or sys.argv[1:]
    if not argv:
        print("Usage: python direct_integration_no_demo.py <config.json> [t_final] [n_steps]")
        sys.exit(0)

    cfg = _load_config(argv[0])
    t_final = float(argv[1]) if len(argv) > 1 else 27e-9
    n_steps = int(argv[2]) if len(argv) > 2 else 100000
    pulse_width = float(cfg.get("pulse_width_s", 0.0))

    system = build_system(cfg)
    t, C, extra = integrate_system(
        system, t_final=t_final, n_steps=n_steps,
        pulse_width=pulse_width
    )

    # ── Export Cl2•- and eS- together for the two-species comparison script ──
    export_species_csv(
        t, C, system,
        species_names=["Cl2•-", "e_s-"],
        path="species_concentration.csv",
    )

    # # ── Full output (all species) ────────────────────────────────────────────
    # out    = pathlib.Path("radiolysis_output.csv")
    # header = ",".join(["t_s"] + extra["species"])
    # data   = np.column_stack([t, C])
    # np.savetxt(out, data, delimiter=",", header=header, comments="")
    # print(f"Full output written to {out.resolve()}")

    out = pathlib.Path("radiolysis_output.csv")
    header = ",".join(["t_s"] + extra["species"])
    data = np.column_stack([t, C])
    np.savetxt(out, data, delimiter=",", header=header, comments="")
    print(f"Full output written to {out.resolve()}")

    quick_plot(t, C, system, species_to_plot=["e_s-"], absorbance_csv="absorbance1mMCr3.csv")

if __name__ == "__main__":
