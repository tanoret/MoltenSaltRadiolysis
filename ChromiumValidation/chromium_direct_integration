# ---- builder
def _species_list_to_objects(spec_names: List[str], phases: Dict[str, str]) -> List[Species]:
    return [Species(name=s, phase=phases.get(s, "liq"), index=i) for i, s in enumerate(spec_names)]

def build_system(config: Dict, db: Optional[Dict] = None) -> System:
    db = db or MINI_DB
    kernel = config["kernel"]; assert kernel in db["kernels"]
    T_K   = float(config.get("temperature_K", 673.15))
    V_liq = float(config.get("liquid_volume_m3", 1.0e-3))
    V_gas = float(config.get("headspace_volume_m3", 0.0))
    kLa   = float(config.get("kLa_s^-1", 0.0))
    dose_rate = float(config.get("dose_rate_J_m3_s", 0.0))
    radiation = str(config.get("radiation", "gamma"))
    g_override = dict(config.get("G_values_override", {}) or {})
    gas_flags = set(config.get("gas_species", []) or [])

    kdb = db["kernels"][kernel]
    species_list = list(kdb["species"])
    phases = dict(kdb["phases"])
    reactions: List[Reaction] = []

    for row in kdb.get("reactions", []):
        reactions.append(_reaction_from_row(row))

    gas_exchanges: List[GasExchange] = []
    if "Cl2" in gas_flags and kernel == "chloride":
        if "Cl2_g" not in species_list:
            species_list.append("Cl2_g")
            phases["Cl2_g"] = "gas"
        gas_exchanges.append(GasExchange(
            name="Cl2", liq_species="Cl2_diss", gas_species="Cl2_g",
            kLa_s=kLa, kH_molm3Pa=db["henry"]["Cl2_mol_m3_Pa"]
        ))
    if "F2" in gas_flags and kernel == "fluoride":
        if "F2_g" not in species_list:
            species_list.append("F2_g")
            phases["F2_g"] = "gas"
        gas_exchanges.append(GasExchange(
            name="F2", liq_species="F2_diss", gas_species="F2_g",
            kLa_s=kLa, kH_molm3Pa=db["henry"]["F2_mol_m3_Pa"]
        ))

    metals_cfg = dict(config.get("metals", {}) or {})
    for metal, conc_map in metals_cfg.items():
        if metal not in db["metals"]:
            continue
        md = db["metals"][metal]
        for sp in md.get("species", []):
            if sp not in species_list:
                species_list.append(sp)
                phases[sp] = "liq"
        tmpl_key = f"{kernel}_templated_reactions"
        for row in md.get(tmpl_key, []):
            reactions.append(_reaction_from_row(row))

    species_objs = _species_list_to_objects(species_list, phases)
    idx = {s.name: s.index for s in species_objs}

    g_kernel = db.get("G_values", {}).get(radiation, {}).get(kernel, {}) or {}
    g_all = {**g_kernel, **g_override}
    sources = build_sources_from_G(g_all, dose_rate)

    sysobj = System(
        species=species_objs, species_index=idx, reactions=reactions, sources=sources,
        T=T_K, V_liq_m3=V_liq, V_gas_m3=V_gas, gas_exchanges=gas_exchanges
    )
    sysobj.initial_concentrations = _assemble_initial(sysobj, config)
    return sysobj

def _reaction_from_row(row: Dict) -> Reaction:
    def _num(v):
        if isinstance(v, str):
            try: return float(v)
            except Exception: return v
        return v
    pars = {k: _num(v) for k, v in row.get("params", {}).items()}
    return Reaction(
        name=row.get("name", "rxn"),
        reactants=dict(row["reactants"]),
        products=dict(row["products"]),
        reversible=bool(row.get("reversible", False)),
        k_ref=pars.get("k_ref"), T_ref=pars.get("T_ref"),
        Ea_J_mol=pars.get("Ea_J_mol"), A=pars.get("A"),
        order_overrides=row.get("orders"), notes=row.get("notes", "")
    )

def _assemble_initial(system: System, config: Dict) -> np.ndarray:
    n = len(system.species)
    C0 = np.zeros(n, dtype=float)
    init = dict(config.get("initial_concentrations", {}) or {})
    for s, v in init.items():
        if s in system.species_index:
            C0[system.species_index[s]] = float(v)
    for _, conc_map in (config.get("metals", {}) or {}).items():
        for s, v in conc_map.items():
            if s in system.species_index:
                C0[system.species_index[s]] = float(v)
    return C0

# ---- RHS
def _rate_law_C(system: System, sp_name: str, y: np.ndarray) -> float:
    s = system.species[system.species_index[sp_name]]
    if s.phase == "gas":
        return 0.0
    return max(0.0, y[s.index])

def _pulse_source_rate(system: System, t: float, 
                        pulse_width: float) -> np.ndarray:
    """
    Returns source rates [mol/L/s] for species with nonzero
    initial_concentrations, ramping linearly from 0 at t=0
    to C0/pulse_width at t=pulse_width, then 0 afterward.
    Only liquid-phase species are sourced.
    
    This produces a linear ramp in concentration that reaches
    exactly C0 at t=pulse_width, equivalent to a constant
    production rate of C0/pulse_width over the pulse duration.
    """
    if pulse_width <= 0.0 or t >= pulse_width:
        return np.zeros(len(system.species))
    
    dy = np.zeros(len(system.species))
    C0 = system.initial_concentrations
    for i, sp in enumerate(system.species):
        if sp.phase == "liq" and C0[i] > 0.0:
            dy[i] = C0[i] / pulse_width
    return dy


def _rhs(system: System, t: float, y: np.ndarray,
         pulse_width: float = 0.0) -> np.ndarray:
    dy = np.zeros_like(y)

    # Reaction network
    for rxn in system.reactions:
        k = rxn.k(system.T)
        if k == 0.0:
            continue
        rate = k
        for sp, sto in rxn.reactants.items():
            order = rxn.order_overrides.get(sp, sto) if rxn.order_overrides else sto
            Ci = _rate_law_C(system, sp, y)
            if order != 0:
                rate *= Ci ** float(order)
        if rate == 0.0 or not math.isfinite(rate):
            continue
        for sp, nu in rxn.reactants.items():
            i = system.species_index.get(sp)
            if i is not None and system.species[i].phase == "liq":
                dy[i] -= rate * nu
        for sp, nu in rxn.products.items():
            i = system.species_index.get(sp)
            if i is not None and system.species[i].phase == "liq":
                dy[i] += rate * nu

    # Radiolytic source: boxcar during pulse only
    # (system.sources is nonzero only if dose_rate_J_m3_s > 0)
    if t <= pulse_width:
        for sp, S in system.sources.items():
            i = system.species_index.get(sp)
            if i is not None and system.species[i].phase == "liq":
                dy[i] += float(S)

    # Gas exchange
    if system.gas_exchanges and system.V_gas_m3 > 0.0:
        for gx in system.gas_exchanges:
            il = system.species_index[gx.liq_species]
            ig = system.species_index[gx.gas_species]
            C_liq = max(0.0, y[il])
            n_gas = max(0.0, y[ig])
            p_gas = n_gas * Rgas * system.T / system.V_gas_m3
            C_eq = gx.kH_molm3Pa * p_gas
            flux = gx.kLa_s * (C_liq - C_eq)
            dy[il] -= flux
            dy[ig] += flux * system.V_liq_m3

    return dy

# ---- integration
def integrate_system(system: System, t_final: float, n_steps: int = 100000,
                     method: str = "auto",
                     pulse_width: float = 0.0) -> Tuple[np.ndarray, np.ndarray, Dict]:
    t0 = 0.0
    t = np.linspace(t0, float(t_final), int(n_steps))

    # Always start from initial_concentrations.
    # For pulse mode, radiolytic species (e_s-, Cl2•-, etc.) should be
    # zero in the config and will be built up by the boxcar source.
    # Non-radiolytic species (Cl-, Cr2+, etc.) retain their physical
    # starting concentrations.
    y0 = np.array(system.initial_concentrations, dtype=float)

    if _HAVE_SCIPY and method == "auto":
        sol = solve_ivp(
            lambda tt, yy: _rhs(system, tt, yy, pulse_width=pulse_width),
            (t0, t[-1]), y0,
            t_eval=t, method="Radau", vectorized=False,
            atol=1e-12, rtol=1e-8
        )
        Y = sol.y.T
        info = {"scipy": True, "status": int(sol.status),
                "nfev": getattr(sol, "nfev", None)}
    else:
        Y = np.zeros((t.size, y0.size))
        Y[0] = y0
        for k in range(1, t.size):
            dt = t[k] - t[k-1]
            y_prev = Y[k-1].copy()
            y = y_prev + dt * _rhs(system, t[k-1], y_prev, pulse_width=pulse_width)
            y = y_prev + dt * _rhs(system, t[k], y, pulse_width=pulse_width)
            Y[k] = np.maximum(0.0, y)
        info = {"scipy": False, "note": "backward-Euler (1 sweep) fallback"}

    extras = {"species": [s.name for s in system.species],
              "phases": [s.phase for s in system.species]}
    return t, Y, extras

# ---- CSV export
def export_Cl2_csv(t: np.ndarray, C: np.ndarray, system: System,
                        species_name: str = "Cl2•-",
                        path: str = "Cl2_concentration.csv") -> None:
    """Export solvated Cl2 concentration vs time to CSV."""
    if species_name not in system.species_index:
        print(f"Warning: '{species_name}' not found in system. Available: {list(system.species_index)}")
        return
    i = system.species_index[species_name]
    out = pathlib.Path(path)
    data = np.column_stack([t, C[:, i]])
    np.savetxt(out, data, delimiter=",",
               header="t_s,Cl2_mol_L", comments="")
    print(f"Cl2 concentration written to {out.resolve()} ({len(t)} points)")

# CSV export for both e_s- and Cl2•-

def export_species_csv(t: np.ndarray,
                       C: np.ndarray,
                       system: System,
                       species_names: List[str],
                       path: str = "species_concentration.csv") -> None:
    """
    Export one or more liquid-phase species concentrations vs time to CSV.

    Parameters
    ----------
    t            : time array [s], shape (n_steps,)
    C            : concentration array [mol/L], shape (n_steps, n_species)
    system       : System object (provides species_index)
    species_names: list of species name strings to export, e.g. ["Cl2•-","e_s-"]
                   Names must match exactly those in system.species_index.
    path         : output file path (default "species_concentration.csv")

    Output columns
    --------------
    t_s, <species_name_0>, <species_name_1>, ...

    Notes
    -----
    Only liquid-phase species are meaningful concentration columns.
    Gas-phase species are stored as moles in the headspace, not mol/L,
    and are silently skipped with a warning.
    Missing species names also produce a warning and are skipped.
    """
    valid_names: List[str] = []
    valid_indices: List[int] = []

    for name in species_names:
        if name not in system.species_index:
            print(f"Warning: '{name}' not found in system. "
                  f"Available: {list(system.species_index)}")
            continue
        idx = system.species_index[name]
        if system.species[idx].phase != "liq":
            print(f"Warning: '{name}' is a gas-phase species (stored as mol, "
                  f"not mol/L) — skipping.")
            continue
        valid_names.append(name)
        valid_indices.append(idx)

    if not valid_names:
        print("Error: no valid liquid-phase species to export.")
        return

    out = pathlib.Path(path)
    # Build header: t_s, then each species name
    # Use a sanitised column name (replace • and spaces for CSV safety)
    def _safe(s: str) -> str:
        return s.replace("•", "rad").replace(" ", "_")

    header = "t_s," + ",".join(_safe(n) for n in valid_names)
    data   = np.column_stack([t] + [C[:, i] for i in valid_indices])
    np.savetxt(out, data, delimiter=",", header=header, comments="")
    print(f"Species concentrations written to {out.resolve()} "
          f"({len(t)} points, columns: {['t_s'] + valid_names})")


