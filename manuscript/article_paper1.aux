\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Synthetic-benchmark results. Ground truth $(\log A^*, E_a^*) = (\ln (2\times 10^{13}),\,33.5\,\mathrm  {kJ/mol})$. Bias is posterior-median minus truth; coverage is the empirical fraction of $90\%$ posterior credible intervals that cover the truth across $50$ replicates; predictive RMSE is on the held-out fourth host at $T=700\,\mathrm  {K}$ in $\log _{10} k$ units. Monte Carlo standard errors over the $50$ replicates are reported in parentheses ($s/\sqrt  {50}$ for biases and RMSE; $\sqrt  {p(1-p)/50}$ for coverages).}}{48}{table.caption.23}\protected@file@percent }
\newlabel{tab:synth_benchmark}{{7}{48}{Synthetic-benchmark results. Ground truth $(\log A^*, E_a^*) = (\ln (2\times 10^{13}),\,33.5\,\mathrm {kJ/mol})$. Bias is posterior-median minus truth; coverage is the empirical fraction of $90\%$ posterior credible intervals that cover the truth across $50$ replicates; predictive RMSE is on the held-out fourth host at $T=700\,\mathrm {K}$ in $\log _{10} k$ units. Monte Carlo standard errors over the $50$ replicates are reported in parentheses ($s/\sqrt {50}$ for biases and RMSE; $\sqrt {p(1-p)/50}$ for coverages)}{table.caption.23}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2}Published-data benchmark on multi-paper Zn$^{2+}$}{49}{subsection.9.2}\protected@file@percent }
\newlabel{sec:comparison:zn}{{9.2}{49}{Published-data benchmark on multi-paper Zn$^{2+}$}{subsection.9.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparator comparison on the multi-paper Zn$^{2+}$+\ensuremath  {e_{\mathrm  {s}}^{-}}\xspace  \ test problem. (a)~In-sample predictive accuracy as elpd$_{\mathrm  {WAIC}}$; higher is better. M$_1$ (naive pool) collapses to $-109$~nats; M$_4$ (weak prior) to $-62$~nats. (b)~Out-of-sample predictive on the held-out Iwamatsu \SI {550}{\celsius } point; same ordering. (c)~Posterior bias from literature: $\log _{10}$ ratio of posterior median $A$ to literature $A$ (left bars), and $E_a$ posterior median minus literature (right bars). M$_4$ has $-35$~kJ/mol bias on $E_a$ (unphysical negative Arrhenius slope).}}{49}{figure.caption.24}\protected@file@percent }
\newlabel{fig:method_comparison}{{2}{49}{Comparator comparison on the multi-paper Zn$^{2+}$+\eS \ test problem. (a)~In-sample predictive accuracy as elpd$_{\mathrm {WAIC}}$; higher is better. M$_1$ (naive pool) collapses to $-109$~nats; M$_4$ (weak prior) to $-62$~nats. (b)~Out-of-sample predictive on the held-out Iwamatsu \SI {550}{\celsius } point; same ordering. (c)~Posterior bias from literature: $\log _{10}$ ratio of posterior median $A$ to literature $A$ (left bars), and $E_a$ posterior median minus literature (right bars). M$_4$ has $-35$~kJ/mol bias on $E_a$ (unphysical negative Arrhenius slope)}{figure.caption.24}{}}
